rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@thai-textile-atlas.app';
    }

    // Public site content: anyone can read, only the admin can write.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit trail: admin-only, append-only (no update or delete).
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at', 'action', 'actor', 'summary', 'payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
